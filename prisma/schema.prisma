// =====================================================================
// PROPYTE CRM — Modelo de datos completo
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["propyte_crm"]
}

// =====================================================================
// ENUMS
// =====================================================================

// Roles de usuario para RBAC
enum UserRole {
  ADMIN
  ASESOR
  BROKER
  MANTENIMIENTO
  // Legacy roles (mantener por compatibilidad hasta migración completa)
  DIRECTOR
  GERENTE
  TEAM_LEADER
  ASESOR_SR
  ASESOR_JR
  HOSTESS
  MARKETING
  DEVELOPER_EXT

  @@schema("propyte_crm")
}

// Nivel en plan de carrera
enum CareerLevel {
  JR
  SR
  TOP_PRODUCER
  TEAM_LEADER
  GERENTE

  @@schema("propyte_crm")
}

// Plazas activas
enum Plaza {
  PDC
  TULUM
  MERIDA

  @@schema("propyte_crm")
}

// Tipo de contacto
enum ContactType {
  LEAD
  PROSPECTO
  CLIENTE
  INVERSIONISTA
  BROKER_EXTERNO
  REFERIDO

  @@schema("propyte_crm")
}

// Fuente del lead (crítico para atribución de marketing)
enum LeadSource {
  WALK_IN
  FACEBOOK_ADS
  GOOGLE_ADS
  INSTAGRAM
  TIKTOK_ADS
  PORTAL_INMOBILIARIO
  REFERIDO_CLIENTE
  REFERIDO_BROKER
  LLAMADA_FRIA
  EVENTO
  WEBSITE
  WHATSAPP
  OTRO

  @@schema("propyte_crm")
}

// Idioma preferido del contacto
enum PreferredLanguage {
  ES
  EN

  @@schema("propyte_crm")
}

// Perfil de inversión (del discovery call)
enum InvestmentProfile {
  END_USER
  INVESTOR_RENTAL
  INVESTOR_FLIP
  INVESTOR_LAND
  MIXED

  @@schema("propyte_crm")
}

// Tipo de propiedad buscada
enum PropertyType {
  DEPARTAMENTO
  CASA
  TERRENO
  MACROLOTE
  LOCAL_COMERCIAL
  OTRO

  @@schema("propyte_crm")
}

// Horizonte de compra
enum PurchaseTimeline {
  IMMEDIATE
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  SIX_PLUS_MONTHS

  @@schema("propyte_crm")
}

// Forma de pago
enum PaymentMethod {
  CONTADO
  CREDITO_HIPOTECARIO
  FINANCIAMIENTO_DIRECTO
  MIXTO

  @@schema("propyte_crm")
}

// Modalidad de compra preferida
enum PurchaseModality {
  PREVENTA
  ENTREGA_INMEDIATA
  REVENTA
  ABIERTO

  @@schema("propyte_crm")
}

// Estrategia de renta
enum RentalStrategy {
  LONG_TERM
  AIRBNB
  BOTH
  NA

  @@schema("propyte_crm")
}

// Temperatura del lead
enum LeadTemperature {
  HOT
  WARM
  COLD
  DEAD

  @@schema("propyte_crm")
}

// Tipo de desarrollo (relación comercial)
enum DevelopmentType {
  PROPIO
  MASTERBROKER
  CORRETAJE

  @@schema("propyte_crm")
}

// Moneda
enum Currency {
  MXN
  USD

  @@schema("propyte_crm")
}

// Estado del desarrollo
enum DevelopmentStatus {
  PREVENTA
  CONSTRUCCION
  ENTREGA_INMEDIATA
  VENDIDO
  SUSPENDIDO

  @@schema("propyte_crm")
}

// Tipo de unidad individual
enum UnitType {
  DEPTO_1REC
  DEPTO_2REC
  DEPTO_3REC
  PENTHOUSE
  CASA
  TERRENO
  MACROLOTE
  LOCAL

  @@schema("propyte_crm")
}

// Estado de la unidad
enum UnitStatus {
  DISPONIBLE
  APARTADA
  VENDIDA
  NO_DISPONIBLE

  @@schema("propyte_crm")
}

// Etapas del pipeline de ventas
enum DealStage {
  NEW_LEAD
  CONTACTED
  DISCOVERY_DONE
  MEETING_SCHEDULED
  MEETING_COMPLETED
  PROPOSAL_SENT
  NEGOTIATION
  RESERVED
  CONTRACT_SIGNED
  CLOSING
  WON
  LOST
  FROZEN

  @@schema("propyte_crm")
}

// Tipo de operación (determina tabla de comisiones)
enum DealType {
  NATIVA_CONTADO
  NATIVA_FINANCIAMIENTO
  MACROLOTE
  CORRETAJE
  MASTERBROKER

  @@schema("propyte_crm")
}

// Razón de pérdida del deal
enum LostReason {
  PRECIO
  COMPETENCIA
  FINANCIAMIENTO_RECHAZADO
  NO_INTERESADO
  NO_CONTACTABLE
  COMPRO_DIRECTO
  DESARROLLO_CANCELADO
  OTRO

  @@schema("propyte_crm")
}

// Estado del pago de comisión
enum CommissionStatus {
  PENDIENTE
  FACTURADA
  PAGADA

  @@schema("propyte_crm")
}

// Tipo de actividad
enum ActivityType {
  CALL_OUTBOUND
  CALL_INBOUND
  WHATSAPP_OUT
  WHATSAPP_IN
  SMS_OUT
  SMS_IN
  EMAIL_SENT
  EMAIL_RECEIVED
  MEETING_VIRTUAL
  MEETING_PRESENTIAL
  MEETING_SHOWROOM
  DISCOVERY_CALL
  PROPOSAL_DELIVERY
  FOLLOW_UP
  WALK_IN
  NOTE
  TASK
  CONTRACT_REVIEW
  CLOSING_ACTIVITY

  @@schema("propyte_crm")
}

// Canal de mensaje (Twilio)
enum MessageChannel {
  WHATSAPP
  SMS

  @@schema("propyte_crm")
}

// Dirección del mensaje
enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("propyte_crm")
}

// Estado del mensaje (Twilio)
enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("propyte_crm")
}

// Estado de actividad
enum ActivityStatus {
  PENDIENTE
  COMPLETADA
  VENCIDA
  CANCELADA

  @@schema("propyte_crm")
}

// Propósito de visita (walk-in)
enum VisitPurpose {
  INVERSION
  USO_PROPIO
  INFORMACION
  OTRO

  @@schema("propyte_crm")
}

// Acción de auditoría
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT

  @@schema("propyte_crm")
}

// Categoría de fuente del lead (para reglas de comisión)
enum LeadSourceCategory {
  PROPYTE_LEAD
  BROKER_LEAD
  ASESOR_LEAD

  @@schema("propyte_crm")
}

// Modo de asignación de leads
enum LeadAssignmentMode {
  ROUND_ROBIN
  PERFORMANCE
  MANUAL
  GUARDIA

  @@schema("propyte_crm")
}

// =====================================================================
// ENUMS REBUILD F1 (Anexo Técnico §B/§D + Anexo B §H/§I/§J)
// =====================================================================

