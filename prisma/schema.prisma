  SEND_WHATSAPP
  SEND_EMAIL
  MAKE_CALL
  ASSIGN
  REASSIGN
  NOTIFY
  UPDATE_FIELD
  ADD_TAG
  CHANGE_STAGE
  ENROLL_PLAN
  ESCALATE
  AI_DRAFT
  AI_REPLY
  AI_CALL_SUMMARY
