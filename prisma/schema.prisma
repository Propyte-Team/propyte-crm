// =====================================================================
// MODELOS
// =====================================================================

// Usuarios del CRM
model User {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String
  role          UserRole
  careerLevel   CareerLevel @default(JR)
  plaza         Plaza
  teamLeaderId  String?
  teamLeader    User?       @relation("TeamMembers", fields: [teamLeaderId], references: [id])
  teamMembers   User[]      @relation("TeamMembers")
  sedetusNumber String?
  sedetusExpiry DateTime?
  isActive      Boolean     @default(true)
  avatarUrl     String?
  phone         String?
  passwordHash  String
  otpHash       String?
  otpExpiresAt  DateTime?

  // Relaciones
  assignedContacts Contact[]      @relation("AssignedContacts")
  deals            Deal[]         @relation("AssignedDeals")
  activities       Activity[]
  walkInsAsHostess WalkIn[]       @relation("HostessWalkIns")
  walkInsAsAdvisor WalkIn[]       @relation("AdvisorWalkIns")
  reservedUnits    Unit[]         @relation("ReservedByUser")
  auditLogs        AuditLog[]
  notifications    Notification[]
  messages         Message[]

  agentIdentities AgentDef[] @relation("AgentIdentity")

  // Relaciones personalizacion & equipos
  ledTeams             Team[]            @relation("TeamLeader")
  forecastTeams        Team[]            @relation("TeamForecast")
  teamMemberships      TeamMember[]
  territoryMemberships TerritoryMember[]
  forecastTerritories  Territory[]       @relation("TerritoryForecast")

  // Relaciones rebuild F1/F6
  quotesCreated           Quote[]           @relation("QuotesCreated")
  dealDocsUploaded        DealDocument[]    @relation("DealDocsUploaded")
  profile                 UserProfile?
  templates               UserTemplate[]
  ownedActionPlans        ActionPlan[]      @relation("OwnedActionPlans")
  controlledConversations Conversation[]    @relation("ControlledConversations")
  googleOAuthToken        GoogleOAuthToken?
  shortlistsCreated       Shortlist[]       @relation("ShortlistsCreated")
  botConfigUpdates        BotConfig[]       @relation("BotConfigUpdatedBy")

  // Metas/Scorecard (§5.14)
  goals        Goal[] @relation("UserGoals")
  goalsCreated Goal[] @relation("GoalsCreated")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
  @@schema("propyte_crm")
}

// Contactos / Leads
model Contact {
  id                String            @id @default(uuid())
  firstName         String
  lastName          String
  email             String?
  phone             String
  secondaryPhone    String?
  contactType       ContactType       @default(COMPRADOR)
  leadSource        LeadSource
  leadSourceDetail  String?
  residenceCity     String?
  residenceCountry  String?
  nationality       String?
  preferredLanguage PreferredLanguage @default(ES)

  // Perfil de inversión (del discovery call)
  investmentProfile InvestmentProfile?
  propertyType      PropertyType?
  purchaseTimeline  PurchaseTimeline?
  budgetMin         Decimal?           @db.Decimal(14, 2)
  budgetMax         Decimal?           @db.Decimal(14, 2)
  paymentMethod     PaymentMethod?
  preferredZone     String?
  purchaseModality  PurchaseModality?
  rentalStrategy    RentalStrategy?

  // Asignación y scoring
  assignedToId String?
  assignedTo   User?           @relation("AssignedContacts", fields: [assignedToId], references: [id])
  temperature  LeadTemperature @default(COLD)
  score        Int             @default(0)
  tags         String[]

  // Campos custom metadata-driven (speckit Personalizacion 3.4)
  custom Json @default("{}")

  // Ciclo de contacto y cumplimiento (Anexo Técnico §B.2)
  contactStatus     ContactStatus   @default(NUEVO)
  lifecycleStage    LifecycleStage?
  urgency           Urgency?
  lastActivityAt    DateTime?
  originalCreatedAt DateTime?
  doNotContact      Boolean         @default(false)
  whatsappOptOut    Boolean         @default(false)
  recordingConsent  Boolean         @default(false)
  zohoId            String?         @unique
  hubContactId      String?
  instagramId       String?         @unique
  messengerPsid     String?         @unique

  // Dedup / merge (confirmación humana salvo phone+email idénticos — Anexo B §K G.6)
  mergedIntoId String?
  mergedInto   Contact?  @relation("MergedContacts", fields: [mergedIntoId], references: [id])
  mergedFrom   Contact[] @relation("MergedContacts")

  // Relaciones
  deals      Deal[]
  activities Activity[]
  walkIns    WalkIn[]
  units      Unit[]     @relation("ReservedByContact")
  messages   Message[]

  // Relaciones rebuild F1
  dossier          ContactDossier?
  conversionEvents ConversionEvent[]
  adAttribution    AdAttribution?
  webBehavior      WebBehavior?
  conversations    Conversation[]
  slaTimers        SlaTimer[]
  connectorLeads   ConnectorLeadLog[]
  shortlists       Shortlist[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("contacts")
  @@schema("propyte_crm")
}

// Desarrollos inmobiliarios
model Development {
  id                    String            @id @default(uuid())
  name                  String
  developerName         String
  developmentType       DevelopmentType
  location              String
  plaza                 Plaza
  totalUnits            Int
  availableUnits        Int
  soldUnits             Int               @default(0)
  reservedUnits         Int               @default(0)
  priceMin              Decimal           @db.Decimal(14, 2)
  priceMax              Decimal           @db.Decimal(14, 2)
  currency              Currency          @default(MXN)
  totalDevelopmentValue Decimal?          @db.Decimal(16, 2)
  commissionRate        Decimal           @db.Decimal(5, 2)
  status                DevelopmentStatus @default(PREVENTA)
  constructionProgress  Int               @default(0)
  deliveryDate          DateTime?
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  brochureUrl           String?
  virtualTourUrl        String?
  amenities             String[]
  description           String            @db.Text
  isActive              Boolean           @default(true)

  // Relaciones
  units Unit[]
  deals Deal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("developments")
  @@schema("propyte_crm")
}

// Unidades individuales de un desarrollo
model Unit {
  id            String      @id @default(uuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id])
  unitNumber    String
  unitType      UnitType
  area_m2       Decimal     @db.Decimal(10, 2)
  price         Decimal     @db.Decimal(14, 2)
  currency      Currency    @default(MXN)
  floor         Int?
  status        UnitStatus  @default(DISPONIBLE)

  // Reservación
  reservedByContactId String?
  reservedByContact   Contact?  @relation("ReservedByContact", fields: [reservedByContactId], references: [id])
  reservedByUserId    String?
  reservedByUser      User?     @relation("ReservedByUser", fields: [reservedByUserId], references: [id])
  reservationDate     DateTime?
  saleDate            DateTime?
  salePrice           Decimal?  @db.Decimal(14, 2)

  // Relaciones
  deals Deal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("units")
  @@schema("propyte_crm")
}

// Operaciones / Pipeline de ventas
model Deal {
  id            String       @id @default(uuid())
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id])
  assignedToId  String
  assignedTo    User         @relation("AssignedDeals", fields: [assignedToId], references: [id])
  developmentId String?
  development   Development? @relation(fields: [developmentId], references: [id])
  unitId        String?
  unit          Unit?        @relation(fields: [unitId], references: [id])

  // Pipeline
  stage             DealStage @default(NEW_LEAD)
  dealType          DealType
  estimatedValue    Decimal   @db.Decimal(14, 2)
  currency          Currency  @default(MXN)
  probability       Int       @default(5)
  expectedCloseDate DateTime
  actualCloseDate   DateTime?

  // Pérdida
  lostReason       LostReason?
  lostReasonDetail String?

  // Comisiones calculadas
  commissionTotal     Decimal?         @db.Decimal(14, 2)
  commissionAdvisor   Decimal?         @db.Decimal(14, 2)
  commissionTL        Decimal?         @db.Decimal(14, 2)
  commissionGerente   Decimal?         @db.Decimal(14, 2)
  commissionDirector  Decimal?         @db.Decimal(14, 2)
  commissionBrokerExt Decimal?         @db.Decimal(14, 2)
  commissionStatus    CommissionStatus @default(PENDIENTE)

  // Atribución
  leadSourceAtDeal String

  // Trazabilidad de migración Zoho (cutover Fase E, consolidado §3.6) — idempotencia + reconciliación
  zohoId String? @unique

  // Referencias al catálogo del Hub (Fase 7 las vuelve obligatorias; aquí preparan el terreno)
  hubDevelopmentId String?
  hubUnitId        String?
  holdId           String?
  holdExpiresAt    DateTime?

  // Fechas hito (paridad Zoho, consolidado §2.3.8)
  reservedAt       DateTime?
  contractSignedAt DateTime?
  deedAt           DateTime?
  deliveredAt      DateTime?

  // Campos custom metadata-driven (speckit Personalizacion 3.4)
  custom Json @default("{}")

  // Broker externo asociado (F6, §2.3.7)
  externalBrokerId String?
  externalBroker   ExternalBroker? @relation(fields: [externalBrokerId], references: [id])

  // Relaciones
  activities       Activity[]
  slaTimers        SlaTimer[]
  quotes           Quote[]
  documents        DealDocument[]
  conversionEvents ConversionEvent[]
  shortlists       Shortlist[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("deals")
  @@schema("propyte_crm")
}

// Actividades e interacciones
model Activity {
  id               String         @id @default(uuid())
  contactId        String
  contact          Contact        @relation(fields: [contactId], references: [id])
  dealId           String?
  deal             Deal?          @relation(fields: [dealId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  activityType     ActivityType
  subject          String
  description      String?        @db.Text
  dueDate          DateTime?
  completedAt      DateTime?
  status           ActivityStatus @default(PENDIENTE)
  outcome          String?
  duration_minutes Int?

  // Trazabilidad Google Workspace (GW-1 Gmail / GW-2 Calendar). FKs lógicas a Gmail/Calendar — no Prisma relations.
  gmailThreadId  String?
  gmailMessageId String? @unique // dedup de mensajes Gmail (un Activity por messageId)
  googleEventId  String? @unique // reservado GW-2 Calendar

  // Twilio Voice (click-to-call §5.11). Índice parcial en SQL manual (WHERE callSid IS NOT NULL).
  callSid      String? @unique
  recordingUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([gmailThreadId])
  @@map("activities")
  @@schema("propyte_crm")
}

// Hilo de Gmail ligero (GW-1): headers + snippet en DB; cuerpo on-demand vía Gmail API (speckit §2.6).
// contactId/dealId/userId son FKs lógicas (constraints en el SQL manual) — sin Prisma relations para
// no expandir Contact/Deal/User. Se consulta por (userId, threadId) y por contactId.
model GmailThread {
  id            String   @id @default(uuid())
  contactId     String
  dealId        String?
  userId        String
  threadId      String // Gmail threadId del asesor dueño del token
  messageCount  Int      @default(1)
  subject       String?
  lastMessageAt DateTime
  direction     String // INBOUND | OUTBOUND | MIXED
  snippet       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, threadId])
  @@index([contactId])
  @@map("gmail_threads")
  @@schema("propyte_crm")
}

// Reglas de comisión configurables
model CommissionRule {
  id                 String             @id @default(uuid())
  dealType           DealType
  leadSourceCategory LeadSourceCategory
  role               UserRole
  percentage         Decimal            @db.Decimal(5, 2)
  isActive           Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commission_rules")
  @@schema("propyte_crm")
}

// Registro de walk-ins
model WalkIn {
  id                String       @id @default(uuid())
  hostessId         String
  hostess           User         @relation("HostessWalkIns", fields: [hostessId], references: [id])
  contactId         String
  contact           Contact      @relation(fields: [contactId], references: [id])
  arrivalTime       DateTime     @default(now())
  departureTime     DateTime?
  visitPurpose      VisitPurpose
  assignedAdvisorId String?
  assignedAdvisor   User?        @relation("AdvisorWalkIns", fields: [assignedAdvisorId], references: [id])
  convertedToDeal   Boolean      @default(false)
  notes             String?      @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("walk_ins")
  @@schema("propyte_crm")
}

// Registro de auditoría
model AuditLog {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String
  changes   Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@schema("propyte_crm")
}

// Cronología por registro: cada cambio de campo en contacts/deals, escrito por trigger
// de Postgres (propyte_crm.log_field_changes) — NO por la app. Polimórfico (entity_type +
// entity_id), por eso sin relaciones FK. actor_id/source se enriquecen vía set_config
// transaccional (ver src/lib/audit/change-context.ts); pueden quedar NULL si el caller no
// los fijó — el trigger igual audita el cambio.
model RecordFieldChange {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  field      String
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  source     String?
  actorId    String?  @map("actor_id")
  changedAt  DateTime @default(now()) @map("changed_at")

  @@index([entityType, entityId, changedAt(sort: Desc)])
  @@index([entityType, field, changedAt(sort: Desc)])
  @@map("record_field_changes")
  @@schema("propyte_crm")
}

// Notificaciones in-app
model Notification {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  title   String
  message String
  type    String // "lead_assigned", "task_overdue", "deal_stagnant", etc.
  isRead  Boolean @default(false)
  link    String? // URL de la entidad relacionada

  createdAt DateTime @default(now())

  @@map("notifications")
  @@schema("propyte_crm")
}

// Configuración global del sistema
model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value Json

  updatedAt DateTime @updatedAt

  @@map("system_config")
  @@schema("propyte_crm")
}

// Mensajes SMS/WhatsApp via Twilio
model Message {
  id                String           @id @default(uuid())
  contactId         String
  contact           Contact          @relation(fields: [contactId], references: [id])
  userId            String?
  user              User?            @relation(fields: [userId], references: [id])
  channel           MessageChannel
  direction         MessageDirection
  body              String           @db.Text
  mediaUrl          String?
  mediaType         String?
  mediaFilename     String?
  mediaMimeType     String?
  twilioSid         String?          @unique
  externalMessageId String?          @unique
  templateName      String?
  status            MessageStatus    @default(QUEUED)
  externalPhone     String?

  // Inbox / bot (Anexo B §I.2)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id])
  sender         MessageSender  @default(SYSTEM)
  aiGenerated    Boolean        @default(false)
  aiAutonomy     AutonomyLevel?
  internalNote   Boolean        @default(false)

  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
  @@index([conversationId, createdAt])
  @@map("messages")
  @@schema("propyte_crm")
}

// Configuración de webhooks salientes (CRM → Zapier)
model WebhookConfig {
  id       String  @id @default(uuid())
  event    String // "contact.created", "deal.won", etc.
  url      String
  isActive Boolean @default(true)
  secret   String // HMAC signing secret

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhook_configs")
  @@schema("propyte_crm")
}

