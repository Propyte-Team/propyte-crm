  CONTACTADO
  EN_SEGUIMIENTO
  DESCARTADO

  @@schema("propyte_crm")
}

enum Urgency {
  ALTA
  MEDIA
  BAJA

  @@schema("propyte_crm")
}

enum DocumentType {
  INE
  PASAPORTE
  FM2
  FM3
  OTRO

  @@schema("propyte_crm")
}

enum MaritalStatus {
  SOLTERO
  CASADO
  DIVORCIADO
  VIUDO
  UNION_LIBRE

  @@schema("propyte_crm")
}

enum TaxRegime {
  PFAE
  PM
  PF

  @@schema("propyte_crm")
}

enum TriggerType {
  EVENT
  TIME
  BEHAVIORAL
  INACTIVITY
  STAGE_CHANGE
  SLA_BREACH
  SCORE_THRESHOLD

  @@schema("propyte_crm")
}

enum WorkflowActionType {
