# =====================================================================
# PROPYTE CRM — Variables de entorno (núcleo)
# Limpieza 2026-06-10 (spec crm-hub-migration-cleanup T6): se retiraron las
# variables de Zoho, Meta, Drive/Dropbox, Anthropic, Banxico y robots — esos
# subsistemas viven ahora en Propyte_hub.
# =====================================================================

# --- Base de datos ---
DATABASE_URL="postgresql://user:password@localhost:5432/propyte_crm"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# --- Twilio (SMS / WhatsApp / llamadas) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- Cron secret (endpoints protegidos tipo cron, si se reactivan) ---
CRON_SECRET="your-cron-secret-here"

# --- Supabase (acceso directo a la BD compartida para scripts/ops locales) ---
# Password del proyecto oaijxdpevakashxshhvm (pooler session, puerto 5432).
# https://supabase.com/dashboard/project/oaijxdpevakashxshhvm/settings/database
SUPABASE_DB_PASSWORD=""
